#!/usr/bin/env bash
set -euo pipefail

implement_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
field_root="$implement_root/build/field"
sample_root=${ATFIELD_SAMPLE_REPO:-"$implement_root/../sample"}
sample_root=$(cd "$sample_root" && pwd)
build_dir="$field_root/.build-host"

if [[ ${ATFIELD_FIELD_BUILD_SHELL:-0} != 1 ]]; then
  exec nix develop --no-write-lock-file "$sample_root#default" --command env \
    ATFIELD_FIELD_BUILD_SHELL=1 "$0"
fi

if [[ ! -f "$sample_root/flake.nix" ]]; then
  echo "sample flake is missing: $sample_root/flake.nix" >&2
  exit 66
fi
for tool in cmake ninja nix; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "required build tool is missing from the Nix shell: $tool" >&2
    exit 69
  fi
done

llvm_prefix=$(nix eval --raw --no-write-lock-file \
  "$sample_root#packages.x86_64-linux.atfield-llc")
llvm_dev=$(nix eval --raw --no-write-lock-file \
  "$sample_root#packages.x86_64-linux.atfield-llc.dev")
llvm_dir="$llvm_dev/lib/cmake/llvm"
nix_pkgs_expr='let
  flake = builtins.getFlake ("path:" + builtins.getEnv "ATFIELD_SAMPLE_ROOT");
  pkgs = flake.inputs.nixpkgs.legacyPackages.x86_64-linux;
in'
glibc=$(ATFIELD_SAMPLE_ROOT="$sample_root" nix eval --raw --impure --expr "$nix_pkgs_expr pkgs.stdenv.cc.libc.outPath")
cxx_runtime=$(ATFIELD_SAMPLE_ROOT="$sample_root" nix eval --raw --impure --expr "$nix_pkgs_expr pkgs.stdenv.cc.cc.lib.outPath")
field_loader="$glibc/lib/ld-linux-x86-64.so.2"
if [[ ! -x "$field_loader" ]]; then
  echo "Nix glibc loader is missing: $field_loader" >&2
  exit 69
fi
field_cxx=${ATFIELD_CXX:-"$llvm_prefix/bin/c++"}
if [[ ! -x "$field_cxx" ]]; then
  echo "Nix C++ compiler is missing: $field_cxx" >&2
  exit 69
fi
if [[ ! -f "$llvm_dir/LLVMConfig.cmake" ]]; then
  echo "LLVM CMake package is missing: $llvm_dir/LLVMConfig.cmake" >&2
  exit 69
fi

cmake -S "$field_root" -B "$build_dir" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_CXX_COMPILER="$field_cxx" \
  -DCMAKE_EXE_LINKER_FLAGS="-Wl,--dynamic-linker=$field_loader -Wl,-rpath,$cxx_runtime/lib" \
  -DLLVM_DIR="$llvm_dir"
cmake --build "$build_dir" --parallel

"$build_dir/atfield-field" --help >/dev/null
