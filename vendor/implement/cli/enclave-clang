#!/usr/bin/env bash
set -euo pipefail

root=${ATFIELD_IMPLEMENT_ROOT:?ATFIELD_IMPLEMENT_ROOT must name the implement repository}
compiler=${ATFIELD_CC:?ATFIELD_CC must name the pinned Clang wrapper}
if [[ ${ATFIELD_FIELD_BOUNDARY:-0} == 1 && ${ATFIELD_FIELD_PIPELINE_READY:-0} != 1 ]]; then
  echo "protect Field pipeline is still being connected" >&2
  exit 70
fi
export ATFIELD_PYTHON=${ATFIELD_PYTHON:-$(command -v python3)}
exec bash "$root/build/codegen/compile-ir-object.sh" "$compiler" "$@"
