 obj-$(CONFIG_X86_SGX_KVM)	+= virt.o
--- a/arch/x86/kernel/cpu/sgx/driver.c
+++ b/arch/x86/kernel/cpu/sgx/driver.c
@@ -26,6 +26,7 @@
 	kref_init(&encl->refcount);
 	xa_init(&encl->page_array);
 	mutex_init(&encl->lock);
+	encl->readiness_state = SGX_ENCL_READINESS_IDLE;
 	INIT_LIST_HEAD(&encl->va_pages);
 	INIT_LIST_HEAD(&encl->mm_list);
 	spin_lock_init(&encl->mm_lock);
@@ -62,6 +63,8 @@
 {
 	struct sgx_encl *encl = file->private_data;
 	struct sgx_encl_mm *encl_mm;
+
+	sgx_encl_readiness_file_release(encl);
 
 	/*
 	 * Drain the remaining mm_list entries. At this point the list contains
@@ -191,8 +194,13 @@
 		sgx_xfrm_reserved_mask = ~xfrm_mask;
 	}
 
+	ret = sgx_encl_readiness_init();
+	if (ret)
+		return ret;
+
 	ret = misc_register(&sgx_dev_enclave);
 	if (ret) {
+		sgx_encl_readiness_exit();
 		pr_info("SGX disabled: Unable to register the /dev/sgx_enclave driver (%d).\n", ret);
 		return ret;
 	}
--- a/arch/x86/kernel/cpu/sgx/encl.c
+++ b/arch/x86/kernel/cpu/sgx/encl.c
@@ -705,6 +705,8 @@
 	struct sgx_encl_page *entry;
 	unsigned long count = 0;
 
+	sgx_encl_readiness_destroy(encl);
+
 	XA_STATE(xas, &encl->page_array, PFN_DOWN(encl->base));
 
 	xas_lock(&xas);
--- a/arch/x86/kernel/cpu/sgx/encl.h
+++ b/arch/x86/kernel/cpu/sgx/encl.h
@@ -48,6 +48,28 @@
 	struct mmu_notifier mmu_notifier;
 };
 
+enum sgx_encl_readiness_state {
+	SGX_ENCL_READINESS_IDLE,
+	SGX_ENCL_READINESS_ACQUIRING,
+	SGX_ENCL_READINESS_ACQUIRED,
+};
+
+struct file;
+struct sgx_encl;
+struct task_struct;
+
+struct sgx_encl_readiness_owner {
+	struct list_head list;
+	struct work_struct cleanup_work;
+	struct task_struct *task;
+	struct mm_struct *mm;
+	struct file *file;
+	struct sgx_encl *encl;
+	bool cleanup_queued;
+};
+
+struct sgx_page_readiness_table;
+
 struct sgx_encl {
 	unsigned long base;
 	unsigned long size;
@@ -63,6 +85,13 @@
 	cpumask_t cpumask;
 	struct file *backing;
 	struct kref refcount;
+	enum sgx_encl_readiness_state readiness_state;
+	struct sgx_encl_readiness_owner *readiness_owner;
+	struct sgx_page_readiness_table *readiness_table;
+	size_t readiness_table_bytes;
+	struct sgx_epc_page **readiness_held_pages;
+	size_t readiness_held_count;
+	size_t readiness_held_capacity;
 	struct list_head va_pages;
 	unsigned long mm_list_version;
 	struct list_head mm_list;
@@ -125,5 +154,13 @@
 					 unsigned long addr);
 struct sgx_va_page *sgx_encl_grow(struct sgx_encl *encl, bool reclaim);
 void sgx_encl_shrink(struct sgx_encl *encl, struct sgx_va_page *va_page);
+int sgx_encl_readiness_init(void);
+void sgx_encl_readiness_exit(void);
+bool sgx_encl_readiness_is_owner_locked(struct sgx_encl *encl);
+void sgx_encl_readiness_file_release(struct sgx_encl *encl);
+long sgx_ioc_enclave_pages_acquire(struct sgx_encl *encl, struct file *file,
+				   void __user *arg);
+long sgx_ioc_enclave_pages_release(struct sgx_encl *encl);
+void sgx_encl_readiness_destroy(struct sgx_encl *encl);
 
 #endif /* _X86_ENCL_H */
--- a/arch/x86/kernel/cpu/sgx/ioctl.c
+++ b/arch/x86/kernel/cpu/sgx/ioctl.c
@@ -1208,8 +1208,29 @@
 	struct sgx_encl *encl = filep->private_data;
 	int ret;
 
-	if (test_and_set_bit(SGX_ENCL_IOCTL, &encl->flags))
-		return -EBUSY;
+	if (!kref_get_unless_zero(&encl->refcount))
+		return -ENODEV;
+
+	if (test_and_set_bit(SGX_ENCL_IOCTL, &encl->flags)) {
+		ret = -EBUSY;
+		goto out_put;
+	}
+
+	mutex_lock(&encl->lock);
+	if (cmd == SGX_IOC_ENCLAVE_PAGES_RELEASE) {
+		if (encl->readiness_state != SGX_ENCL_READINESS_ACQUIRED)
+			ret = -EINVAL;
+		else if (!sgx_encl_readiness_is_owner_locked(encl))
+			ret = -EPERM;
+		else
+			ret = 0;
+	} else {
+		ret = encl->readiness_state == SGX_ENCL_READINESS_IDLE ?
+			0 : -EBUSY;
+	}
+	mutex_unlock(&encl->lock);
+	if (ret)
+		goto out_clear;
 
 	switch (cmd) {
 	case SGX_IOC_ENCLAVE_CREATE:
@@ -1234,11 +1255,21 @@
 	case SGX_IOC_ENCLAVE_REMOVE_PAGES:
 		ret = sgx_ioc_enclave_remove_pages(encl, (void __user *)arg);
 		break;
+	case SGX_IOC_ENCLAVE_PAGES_ACQUIRE:
+		ret = sgx_ioc_enclave_pages_acquire(encl, filep,
+						    (void __user *)arg);
+		break;
+	case SGX_IOC_ENCLAVE_PAGES_RELEASE:
+		ret = sgx_ioc_enclave_pages_release(encl);
+		break;
 	default:
 		ret = -ENOIOCTLCMD;
 		break;
 	}
 
+out_clear:
 	clear_bit(SGX_ENCL_IOCTL, &encl->flags);
-	return ret;
-}
+out_put:
+	kref_put(&encl->refcount, sgx_encl_release);
+	return ret;
+}
--- a/arch/x86/kernel/cpu/sgx/main.c
+++ b/arch/x86/kernel/cpu/sgx/main.c
@@ -526,8 +526,12 @@
  *   0 on success,
  *   -EBUSY if the page is in the process of being reclaimed
  */
-int sgx_unmark_page_reclaimable(struct sgx_epc_page *page)
-{
+static int __sgx_unmark_page_reclaimable(struct sgx_epc_page *page,
+					 bool *detached)
+{
+	if (detached)
+		*detached = false;
+
 	spin_lock(&sgx_reclaimer_lock);
 	if (page->flags & SGX_EPC_PAGE_RECLAIMER_TRACKED) {
 		/* The page is being reclaimed. */
@@ -538,10 +542,26 @@
 
 		list_del(&page->list);
 		page->flags &= ~SGX_EPC_PAGE_RECLAIMER_TRACKED;
+		if (detached)
+			*detached = true;
 	}
 	spin_unlock(&sgx_reclaimer_lock);
 
 	return 0;
+}
+
+int sgx_unmark_page_reclaimable(struct sgx_epc_page *page)
+{
+	return __sgx_unmark_page_reclaimable(page, NULL);
+}
+
+int sgx_unmark_page_reclaimable_detached(struct sgx_epc_page *page,
+					 bool *detached)
+{
+	if (!detached)
+		return -EINVAL;
+
+	return __sgx_unmark_page_reclaimable(page, detached);
 }
 
 /**
--- a/arch/x86/kernel/cpu/sgx/readiness.c
+++ b/arch/x86/kernel/cpu/sgx/readiness.c
@@ -0,0 +1,797 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/err.h>
+#include <linux/file.h>
+#include <linux/lockdep.h>
+#include <linux/mm.h>
+#include <linux/overflow.h>
+#include <linux/sched/mm.h>
+#include <linux/sched/task.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/uaccess.h>
+#include <trace/events/sched.h>
+#include <asm/pgtable.h>
+#include "driver.h"
+#include "encl.h"
+
+#define SGX_READY_TABLE_VERSION 3
+#define SGX_READY_ENTRY_WORDS 3
+
+struct sgx_page_readiness_table {
+	u64 format_version;
+	u64 entry_count;
+	u64 total_page_count;
+	u64 reserved;
+	u64 words[];
+};
+
+static DEFINE_SPINLOCK(sgx_readiness_owner_lock);
+static LIST_HEAD(sgx_readiness_owners);
+
+static void sgx_ready_owner_cleanup_work(struct work_struct *work);
+static struct sgx_epc_page **
+sgx_ready_release_held_locked(struct sgx_encl *encl);
+static void sgx_ready_owner_put(struct sgx_encl_readiness_owner *owner);
+
+static void sgx_readiness_cleanup_task(struct task_struct *task, bool exec)
+{
+	struct sgx_encl_readiness_owner *owner, *next;
+	unsigned long flags;
+
+	spin_lock_irqsave(&sgx_readiness_owner_lock, flags);
+	list_for_each_entry_safe(owner, next, &sgx_readiness_owners, list) {
+		if (owner->task != task || (exec && owner->mm == task->mm))
+			continue;
+
+		owner->cleanup_queued = true;
+		list_del_init(&owner->list);
+		schedule_work(&owner->cleanup_work);
+	}
+	spin_unlock_irqrestore(&sgx_readiness_owner_lock, flags);
+}
+
+static void sgx_readiness_task_exit(void *data, struct task_struct *task,
+				    bool group_dead)
+{
+	sgx_readiness_cleanup_task(task, false);
+}
+
+static void sgx_readiness_task_exec(void *data, struct task_struct *task,
+				    pid_t old_pid, struct linux_binprm *bprm)
+{
+	sgx_readiness_cleanup_task(task, true);
+}
+
+int sgx_encl_readiness_init(void)
+{
+	int ret;
+
+	ret = register_trace_sched_process_exit(sgx_readiness_task_exit, NULL);
+	if (ret)
+		return ret;
+
+	ret = register_trace_sched_process_exec(sgx_readiness_task_exec, NULL);
+	if (ret) {
+		unregister_trace_sched_process_exit(sgx_readiness_task_exit, NULL);
+		tracepoint_synchronize_unregister();
+	}
+
+	return ret;
+}
+
+void sgx_encl_readiness_exit(void)
+{
+	unregister_trace_sched_process_exec(sgx_readiness_task_exec, NULL);
+	unregister_trace_sched_process_exit(sgx_readiness_task_exit, NULL);
+	tracepoint_synchronize_unregister();
+}
+
+bool sgx_encl_readiness_is_owner_locked(struct sgx_encl *encl)
+{
+	struct sgx_encl_readiness_owner *owner = encl->readiness_owner;
+	unsigned long flags;
+	bool is_owner;
+
+	lockdep_assert_held(&encl->lock);
+	if (!owner || !current->mm)
+		return false;
+
+	spin_lock_irqsave(&sgx_readiness_owner_lock, flags);
+	is_owner = !owner->cleanup_queued && owner->task == current &&
+		   owner->mm == current->mm;
+	spin_unlock_irqrestore(&sgx_readiness_owner_lock, flags);
+
+	return is_owner;
+}
+
+static void sgx_ready_owner_attach_locked(struct sgx_encl *encl,
+					  struct sgx_encl_readiness_owner *owner,
+					  struct mm_struct *mm,
+					  struct file *file)
+{
+	unsigned long flags;
+
+	owner->task = current;
+	get_task_struct(current);
+	owner->mm = mm;
+	mmgrab(mm);
+	owner->file = get_file(file);
+	owner->encl = encl;
+	INIT_LIST_HEAD(&owner->list);
+	INIT_WORK(&owner->cleanup_work, sgx_ready_owner_cleanup_work);
+	kref_get(&encl->refcount);
+
+	spin_lock_irqsave(&sgx_readiness_owner_lock, flags);
+	list_add_tail(&owner->list, &sgx_readiness_owners);
+	encl->readiness_owner = owner;
+	spin_unlock_irqrestore(&sgx_readiness_owner_lock, flags);
+}
+
+static struct sgx_encl_readiness_owner *
+sgx_ready_owner_detach_locked(struct sgx_encl *encl)
+{
+	struct sgx_encl_readiness_owner *owner = encl->readiness_owner;
+	unsigned long flags;
+
+	if (!owner)
+		return NULL;
+
+	spin_lock_irqsave(&sgx_readiness_owner_lock, flags);
+	if (owner->cleanup_queued) {
+		owner = NULL;
+	} else {
+		list_del_init(&owner->list);
+		encl->readiness_owner = NULL;
+	}
+	spin_unlock_irqrestore(&sgx_readiness_owner_lock, flags);
+
+	return owner;
+}
+
+static void sgx_ready_owner_put(struct sgx_encl_readiness_owner *owner)
+{
+	struct sgx_encl *encl = owner->encl;
+	struct file *file = owner->file;
+
+	put_task_struct(owner->task);
+	mmdrop(owner->mm);
+	kfree(owner);
+	/* The file release callback may access @encl. Keep its owner ref until
+	 * fput() has completed any synchronous final release work.
+	 */
+	fput(file);
+	kref_put(&encl->refcount, sgx_encl_release);
+}
+
+static int sgx_ready_table_size(const struct sgx_page_readiness_table *table,
+				size_t *bytes)
+{
+	size_t entries_bytes;
+	size_t pages_bytes;
+
+	if (table->entry_count >
+	    (SIZE_MAX - sizeof(*table)) / (SGX_READY_ENTRY_WORDS * sizeof(u64)))
+		return -EINVAL;
+
+	entries_bytes = table->entry_count * SGX_READY_ENTRY_WORDS * sizeof(u64);
+	if (table->total_page_count >
+	    (SIZE_MAX - sizeof(*table) - entries_bytes) / sizeof(u64))
+		return -EINVAL;
+
+	pages_bytes = table->total_page_count * sizeof(u64);
+	*bytes = sizeof(*table) + entries_bytes + pages_bytes;
+	return 0;
+}
+
+static int sgx_ready_table_validate(struct sgx_encl *encl,
+				    struct sgx_page_readiness_table *table,
+				    size_t bytes)
+{
+	u64 *pages;
+	u64 page_cursor = 0;
+	u64 previous_selector = 0;
+	size_t expected;
+	u64 i;
+
+	if (table->format_version != SGX_READY_TABLE_VERSION ||
+	    !table->entry_count || !table->total_page_count || table->reserved)
+		return -EINVAL;
+
+	if (sgx_ready_table_size(table, &expected) || expected != bytes)
+		return -EINVAL;
+
+	pages = &table->words[table->entry_count * SGX_READY_ENTRY_WORDS];
+
+	for (i = 0; i < table->entry_count; i++) {
+		u64 *entry = &table->words[i * SGX_READY_ENTRY_WORDS];
+		u64 selector = entry[0];
+		u64 first_page = entry[1];
+		u64 page_count = entry[2];
+		u64 previous_rva = 0;
+		u64 j;
+
+		if ((i && selector <= previous_selector) ||
+		    first_page != page_cursor ||
+		    page_count > table->total_page_count - page_cursor)
+			return -EINVAL;
+
+		for (j = 0; j < page_count; j++) {
+			u64 rva = pages[first_page + j];
+
+			if (!IS_ALIGNED(rva, PAGE_SIZE) ||
+			    rva >= encl->size ||
+			    encl->size - rva < PAGE_SIZE ||
+			    (j && rva <= previous_rva))
+				return -EINVAL;
+
+			previous_rva = rva;
+		}
+
+		previous_selector = selector;
+		page_cursor += page_count;
+	}
+
+	return page_cursor == table->total_page_count ? 0 : -EINVAL;
+}
+
+static struct sgx_page_readiness_table *
+sgx_ready_table_copy(struct sgx_encl *encl, u64 user_ptr, u64 table_bytes,
+		     int *error)
+{
+	struct sgx_page_readiness_table header;
+	struct sgx_page_readiness_table *table;
+	void __user *user_table = u64_to_user_ptr(user_ptr);
+	size_t expected;
+
+	if (!user_ptr || !table_bytes || table_bytes > SIZE_MAX ||
+	    table_bytes < sizeof(header)) {
+		*error = -EINVAL;
+		return NULL;
+	}
+
+	if (copy_from_user(&header, user_table, sizeof(header))) {
+		*error = -EFAULT;
+		return NULL;
+	}
+
+	if (sgx_ready_table_size(&header, &expected) ||
+	    expected != table_bytes) {
+		*error = -EINVAL;
+		return NULL;
+	}
+
+	table = kvmalloc((size_t)table_bytes, GFP_KERNEL);
+	if (!table) {
+		*error = -ENOMEM;
+		return NULL;
+	}
+
+	if (copy_from_user(table, user_table, (size_t)table_bytes)) {
+		kvfree(table);
+		*error = -EFAULT;
+		return NULL;
+	}
+
+	*error = sgx_ready_table_validate(encl, table, (size_t)table_bytes);
+	if (*error) {
+		kvfree(table);
+		return NULL;
+	}
+
+	return table;
+}
+
+static int sgx_ready_find_entry(const struct sgx_page_readiness_table *table,
+				u64 selector, u64 *first_page,
+				u64 *page_count)
+{
+	size_t low = 0;
+	size_t high = table->entry_count;
+
+	while (low < high) {
+		size_t middle = low + (high - low) / 2;
+		const u64 *entry = &table->words[middle * SGX_READY_ENTRY_WORDS];
+
+		if (selector < entry[0]) {
+			high = middle;
+		} else if (selector > entry[0]) {
+			low = middle + 1;
+		} else {
+			*first_page = entry[1];
+			*page_count = entry[2];
+			return 0;
+		}
+	}
+
+	return -ENOENT;
+}
+
+static bool sgx_ready_vma_within_page_max(struct sgx_encl_page *entry,
+					  struct vm_area_struct *vma)
+{
+	vm_flags_t access = vma->vm_flags & VM_ACCESS_FLAGS;
+
+	return (entry->vm_max_prot_bits & access) == access;
+}
+
+static int sgx_ready_validate_vma(struct sgx_encl *encl,
+				  struct mm_struct *mm, u64 rva,
+				  unsigned long *address,
+				  struct vm_area_struct **vma_out)
+{
+	unsigned long enclave_end;
+	unsigned long end;
+	struct vm_area_struct *vma;
+	struct sgx_encl_page *entry;
+	int ret = 0;
+
+	if (!IS_ALIGNED(rva, PAGE_SIZE) || rva > ULONG_MAX ||
+	    check_add_overflow(encl->base, (unsigned long)rva, address) ||
+	    check_add_overflow(*address, PAGE_SIZE, &end) ||
+	    check_add_overflow(encl->base, encl->size, &enclave_end) ||
+	    *address < encl->base || end > enclave_end)
+		return -EINVAL;
+
+	vma = vma_lookup(mm, *address);
+	if (!vma || vma->vm_start > *address || vma->vm_end < end)
+		return -EFAULT;
+
+	if (vma->vm_ops != &sgx_vm_ops || vma->vm_private_data != encl)
+		return -EXDEV;
+
+	if (!(vma->vm_flags & VM_READ))
+		return -EACCES;
+
+	mutex_lock(&encl->lock);
+	entry = xa_load(&encl->page_array, PFN_DOWN(*address));
+	if (!entry || entry->encl != encl ||
+	    entry->type != SGX_PAGE_TYPE_REG) {
+		ret = -EINVAL;
+	} else if (!sgx_ready_vma_within_page_max(entry, vma)) {
+		ret = -EACCES;
+	}
+	mutex_unlock(&encl->lock);
+
+	if (!ret)
+		*vma_out = vma;
+
+	return ret;
+}
+
+static int sgx_ready_fault_error(vm_fault_t fault)
+{
+	if (fault & VM_FAULT_OOM)
+		return -ENOMEM;
+	if (fault & VM_FAULT_SIGBUS)
+		return -EFAULT;
+	if (fault & VM_FAULT_HWPOISON)
+		return -EHWPOISON;
+	return -EIO;
+}
+
+/*
+ * On success, return with mmap_lock held and a revalidated VMA.
+ */
+static int sgx_ready_fault_page(struct sgx_encl *encl, struct mm_struct *mm,
+				u64 rva, bool *fault_tried,
+				unsigned long *address,
+				struct vm_area_struct **vma)
+{
+	vm_fault_t fault;
+	unsigned int flags;
+	int ret;
+
+	for (;;) {
+		ret = mmap_read_lock_killable(mm);
+		if (ret)
+			return ret;
+
+		ret = sgx_ready_validate_vma(encl, mm, rva, address, vma);
+		if (ret) {
+			mmap_read_unlock(mm);
+			return ret;
+		}
+
+		flags = FAULT_FLAG_USER | FAULT_FLAG_ALLOW_RETRY |
+			FAULT_FLAG_KILLABLE | FAULT_FLAG_INTERRUPTIBLE;
+		if ((*vma)->vm_flags & VM_WRITE)
+			flags |= FAULT_FLAG_WRITE;
+		else if ((*vma)->vm_flags & VM_EXEC)
+			flags |= FAULT_FLAG_INSTRUCTION;
+		if (*fault_tried)
+			flags |= FAULT_FLAG_TRIED;
+
+		fault = handle_mm_fault(*vma, *address, flags, NULL);
+		if (fault & VM_FAULT_ERROR) {
+			ret = sgx_ready_fault_error(fault);
+			mmap_read_unlock(mm);
+			return ret;
+		}
+
+		if (fault & VM_FAULT_RETRY) {
+			/* handle_mm_fault() released mmap_lock. */
+			if (*fault_tried || signal_pending(current))
+				return signal_pending(current) ? -EINTR : -EAGAIN;
+
+			*fault_tried = true;
+			continue;
+		}
+
+		if (fault & VM_FAULT_COMPLETED) {
+			/* The VMA can change while the fault path drops mmap_lock. */
+			ret = mmap_read_lock_killable(mm);
+			if (ret)
+				return ret;
+
+			ret = sgx_ready_validate_vma(encl, mm, rva, address, vma);
+			if (ret) {
+				mmap_read_unlock(mm);
+				return ret;
+			}
+		}
+
+		return 0;
+	}
+}
+
+static int sgx_ready_verify_and_hold(struct sgx_encl *encl,
+				     struct vm_area_struct *vma,
+				     unsigned long address,
+				     struct sgx_encl_page *entry,
+				     bool *retry_race)
+{
+	struct follow_pfnmap_args args = {
+		.vma = vma,
+		.address = address,
+	};
+	struct sgx_epc_page *epc_page;
+	pte_t pte;
+	u64 prot;
+	bool detached;
+	int ret;
+
+	*retry_race = false;
+	if (!entry || entry->encl != encl ||
+	    entry->type != SGX_PAGE_TYPE_REG)
+		return -EINVAL;
+
+	epc_page = entry->epc_page;
+	if (!epc_page) {
+		*retry_race = true;
+		return -EAGAIN;
+	}
+
+	ret = follow_pfnmap_start(&args);
+	if (ret) {
+		*retry_race = true;
+		return -EAGAIN;
+	}
+
+	prot = pgprot_val(args.pgprot);
+	pte = __pte(prot);
+	if (args.addr_mask != PAGE_MASK || !args.special ||
+	    !pte_present(pte) || pte_protnone(pte) ||
+	    !(prot & _PAGE_USER)) {
+		ret = -EFAULT;
+		goto out_pte;
+	}
+
+	if (args.pfn != PFN_DOWN(sgx_get_epc_phys_addr(epc_page))) {
+		ret = -EFAULT;
+		goto out_pte;
+	}
+
+	if (args.writable != !!(vma->vm_flags & VM_WRITE) ||
+	    pte_exec(pte) != !!(vma->vm_flags & VM_EXEC)) {
+		ret = -EACCES;
+		goto out_pte;
+	}
+
+	follow_pfnmap_end(&args);
+
+	if (encl->readiness_held_count >=
+	    encl->readiness_held_capacity)
+		return -EOVERFLOW;
+
+	ret = sgx_unmark_page_reclaimable_detached(epc_page, &detached);
+	if (ret == -EBUSY) {
+		*retry_race = true;
+		return -EAGAIN;
+	}
+	if (ret)
+		return ret;
+
+	if (detached)
+		encl->readiness_held_pages[encl->readiness_held_count++] =
+			epc_page;
+
+	return 0;
+
+out_pte:
+	follow_pfnmap_end(&args);
+	return ret;
+}
+
+static int sgx_ready_acquire_page(struct sgx_encl *encl, struct mm_struct *mm,
+				  u64 rva, bool *fault_tried)
+{
+	unsigned long address;
+	struct vm_area_struct *vma;
+	struct sgx_encl_page *entry;
+	bool retry_race;
+	unsigned int retries = 0;
+	int ret;
+
+	for (;;) {
+		ret = sgx_ready_fault_page(encl, mm, rva, fault_tried,
+					   &address, &vma);
+		if (ret)
+			return ret;
+
+		mutex_lock(&encl->lock);
+		entry = xa_load(&encl->page_array, PFN_DOWN(address));
+		if (!entry || entry->encl != encl ||
+		    entry->type != SGX_PAGE_TYPE_REG) {
+			ret = -EINVAL;
+			retry_race = false;
+		} else if (!sgx_ready_vma_within_page_max(entry, vma)) {
+			ret = -EACCES;
+			retry_race = false;
+		} else {
+			ret = sgx_ready_verify_and_hold(encl, vma, address,
+							entry, &retry_race);
+		}
+		mutex_unlock(&encl->lock);
+		mmap_read_unlock(mm);
+
+		if (!retry_race)
+			return ret;
+		if (retries++)
+			return -EAGAIN;
+	}
+}
+
+static struct sgx_epc_page **
+sgx_ready_release_held_locked(struct sgx_encl *encl)
+{
+	struct sgx_epc_page **held_pages = encl->readiness_held_pages;
+	size_t i;
+
+	for (i = encl->readiness_held_count; i > 0; i--)
+		sgx_mark_page_reclaimable(held_pages[i - 1]);
+
+	encl->readiness_held_pages = NULL;
+	encl->readiness_held_count = 0;
+	encl->readiness_held_capacity = 0;
+	encl->readiness_state = SGX_ENCL_READINESS_IDLE;
+
+	return held_pages;
+}
+
+static void sgx_ready_owner_cleanup_work(struct work_struct *work)
+{
+	struct sgx_encl_readiness_owner *owner =
+		container_of(work, struct sgx_encl_readiness_owner, cleanup_work);
+	struct sgx_encl *encl = owner->encl;
+	struct sgx_epc_page **held_pages = NULL;
+
+	mutex_lock(&encl->lock);
+	if (encl->readiness_owner == owner) {
+		held_pages = sgx_ready_release_held_locked(encl);
+		encl->readiness_owner = NULL;
+	}
+	mutex_unlock(&encl->lock);
+
+	kvfree(held_pages);
+	sgx_ready_owner_put(owner);
+}
+
+void sgx_encl_readiness_file_release(struct sgx_encl *encl)
+{
+	struct sgx_epc_page **held_pages;
+
+	mutex_lock(&encl->lock);
+	/* An active owner holds a file reference through RELEASE or cleanup. */
+	if (encl->readiness_owner) {
+		mutex_unlock(&encl->lock);
+		return;
+	}
+
+	held_pages = sgx_ready_release_held_locked(encl);
+	mutex_unlock(&encl->lock);
+
+	kvfree(held_pages);
+}
+
+static void sgx_ready_rollback(struct sgx_encl *encl)
+{
+	struct sgx_encl_readiness_owner *owner;
+	struct sgx_epc_page **held_pages;
+
+	mutex_lock(&encl->lock);
+	held_pages = sgx_ready_release_held_locked(encl);
+	owner = sgx_ready_owner_detach_locked(encl);
+	mutex_unlock(&encl->lock);
+
+	kvfree(held_pages);
+	if (owner)
+		sgx_ready_owner_put(owner);
+}
+
+long sgx_ioc_enclave_pages_acquire(struct sgx_encl *encl, struct file *file,
+				   void __user *arg)
+{
+	struct sgx_enclave_pages_acquire request;
+	struct sgx_page_readiness_table *candidate = NULL;
+	struct sgx_page_readiness_table *table;
+	struct sgx_encl_readiness_owner *owner = NULL;
+	struct mm_struct *mm = current->mm;
+	u64 *pages;
+	u64 first_page;
+	u64 page_count;
+	bool install_table;
+	bool fault_tried = false;
+	size_t i;
+	int ret;
+
+	if (!mm)
+		return -EINVAL;
+
+	if (copy_from_user(&request, arg, sizeof(request)))
+		return -EFAULT;
+
+	mutex_lock(&encl->lock);
+	if (encl->readiness_state != SGX_ENCL_READINESS_IDLE) {
+		ret = -EBUSY;
+		install_table = false;
+		table = NULL;
+	} else if (encl->readiness_table) {
+		if (request.table_ptr || request.table_bytes) {
+			ret = -EINVAL;
+			table = NULL;
+		} else {
+			ret = 0;
+			table = encl->readiness_table;
+		}
+		install_table = false;
+	} else {
+		if (!request.table_ptr || !request.table_bytes) {
+			ret = -EINVAL;
+			table = NULL;
+		} else {
+			ret = 0;
+			table = NULL;
+		}
+		install_table = true;
+	}
+	mutex_unlock(&encl->lock);
+	if (ret)
+		return ret;
+
+	if (install_table) {
+		candidate = sgx_ready_table_copy(encl, request.table_ptr,
+						 request.table_bytes, &ret);
+		if (!candidate)
+			return ret;
+		table = candidate;
+	}
+
+	ret = sgx_ready_find_entry(table, request.selector, &first_page,
+				   &page_count);
+	if (ret)
+		goto out_free_candidate;
+	if (!page_count || page_count > SIZE_MAX / sizeof(*encl->readiness_held_pages)) {
+		ret = -EINVAL;
+		goto out_free_candidate;
+	}
+
+	pages = &table->words[table->entry_count * SGX_READY_ENTRY_WORDS];
+	{
+		struct sgx_epc_page **held_pages;
+
+		held_pages = kvcalloc((size_t)page_count, sizeof(*held_pages),
+				      GFP_KERNEL);
+		if (!held_pages) {
+			ret = -ENOMEM;
+			goto out_free_candidate;
+		}
+
+		owner = kzalloc_obj(*owner);
+		if (!owner) {
+			kvfree(held_pages);
+			ret = -ENOMEM;
+			goto out_free_candidate;
+		}
+
+		mutex_lock(&encl->lock);
+		if (encl->readiness_state != SGX_ENCL_READINESS_IDLE ||
+		    encl->readiness_owner ||
+		    (install_table ? !!encl->readiness_table :
+		     encl->readiness_table != table)) {
+			mutex_unlock(&encl->lock);
+			kvfree(held_pages);
+			ret = -EBUSY;
+			goto out_free_candidate;
+		}
+
+		sgx_ready_owner_attach_locked(encl, owner, mm, file);
+		owner = NULL;
+		encl->readiness_state = SGX_ENCL_READINESS_ACQUIRING;
+		encl->readiness_held_pages = held_pages;
+		encl->readiness_held_capacity = (size_t)page_count;
+		encl->readiness_held_count = 0;
+		mutex_unlock(&encl->lock);
+	}
+
+	for (i = 0; i < page_count; i++) {
+		ret = sgx_ready_acquire_page(encl, mm,
+					     pages[first_page + i],
+					     &fault_tried);
+		if (ret)
+			goto out_rollback;
+	}
+
+	mutex_lock(&encl->lock);
+	if (encl->readiness_state != SGX_ENCL_READINESS_ACQUIRING ||
+	    !sgx_encl_readiness_is_owner_locked(encl)) {
+		mutex_unlock(&encl->lock);
+		ret = -EIO;
+		goto out_rollback;
+	}
+
+	if (install_table) {
+		encl->readiness_table = candidate;
+		encl->readiness_table_bytes = (size_t)request.table_bytes;
+		candidate = NULL;
+	}
+	encl->readiness_state = SGX_ENCL_READINESS_ACQUIRED;
+	mutex_unlock(&encl->lock);
+
+	ret = 0;
+	goto out_free_candidate;
+
+out_rollback:
+	sgx_ready_rollback(encl);
+out_free_candidate:
+	kfree(owner);
+	kvfree(candidate);
+	return ret;
+}
+
+long sgx_ioc_enclave_pages_release(struct sgx_encl *encl)
+{
+	struct sgx_encl_readiness_owner *owner;
+	struct sgx_epc_page **held_pages = NULL;
+	int ret;
+
+	mutex_lock(&encl->lock);
+	if (encl->readiness_state != SGX_ENCL_READINESS_ACQUIRED) {
+		ret = -EINVAL;
+	} else if (!sgx_encl_readiness_is_owner_locked(encl)) {
+		ret = -EPERM;
+	} else {
+		owner = sgx_ready_owner_detach_locked(encl);
+		if (!owner) {
+			ret = -EPERM;
+		} else {
+			held_pages = sgx_ready_release_held_locked(encl);
+			ret = 0;
+		}
+	}
+	mutex_unlock(&encl->lock);
+
+	kvfree(held_pages);
+	if (ret == 0)
+		sgx_ready_owner_put(owner);
+
+	return ret;
+}
+
+void sgx_encl_readiness_destroy(struct sgx_encl *encl)
+{
+	WARN_ON_ONCE(encl->readiness_state == SGX_ENCL_READINESS_ACQUIRING);
+	WARN_ON_ONCE(encl->readiness_owner);
+	kvfree(encl->readiness_held_pages);
+	kvfree(encl->readiness_table);
+}
