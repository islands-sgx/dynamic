Subject: [PATCH] x86/sgx: bind page readiness to its owner task

Bind ACQUIRE and RELEASE to one task and mm. Keep the enclave file alive
through RELEASE, and reclaim held EPC pages when the owner exits or execs.

---
--- a/arch/x86/include/uapi/asm/sgx.h
+++ b/arch/x86/include/uapi/asm/sgx.h
@@ -35,6 +35,10 @@
 	_IOWR(SGX_MAGIC, 0x06, struct sgx_enclave_modify_types)
 #define SGX_IOC_ENCLAVE_REMOVE_PAGES \
 	_IOWR(SGX_MAGIC, 0x07, struct sgx_enclave_remove_pages)
+#define SGX_IOC_ENCLAVE_PAGES_ACQUIRE \
+	_IOW(SGX_MAGIC, 0x0A, struct sgx_enclave_pages_acquire)
+#define SGX_IOC_ENCLAVE_PAGES_RELEASE \
+	_IO(SGX_MAGIC, 0x0B)
 
 /**
  * struct sgx_enclave_create - parameter structure for the
@@ -138,6 +142,20 @@
 	__u64 count;
 };
 
+/**
+ * struct sgx_enclave_pages_acquire - parameters for page readiness acquire
+ * @selector: public ECALL selector to prepare
+ * @table_ptr: user address of the readiness table before its first install
+ * @table_bytes: exact byte length of the readiness table before its first install
+ *
+ * After the table is installed, both @table_ptr and @table_bytes must be zero.
+ */
+struct sgx_enclave_pages_acquire {
+	__u64 selector;
+	__u64 table_ptr;
+	__u64 table_bytes;
+};
+
 struct sgx_enclave_run;
 
 /**
