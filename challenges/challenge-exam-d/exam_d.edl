enclave {
    trusted {
        public sgx_status_t examD_mint_grant(
            uint32_t grant_scope,
            [out, size=g_len] uint8_t *g_out,
            size_t g_len
        );
        public sgx_status_t examD_consume_grant(
            uint32_t grant_op,
            [in, size=g_len] const uint8_t *g_in,
            size_t g_len,
            [out, size=out_len] uint8_t *out_buf,
            size_t out_len
        );
        public sgx_status_t examD_boot_ledger(uint32_t ledger_seed);
        public sgx_status_t examD_override_mode(uint32_t mode_code);
        public sgx_status_t examD_bump_cursor(uint32_t cursor_inc);
        public sgx_status_t examD_eval_record(
            uint32_t rec_op,
            [in, size=rec_len] const uint8_t *rec_buf,
            size_t rec_len,
            [in, size=sig_len] const uint8_t *sig_buf,
            size_t sig_len,
            [out, size=out_len] uint8_t *out_buf,
            size_t out_len
        );
    };
};
