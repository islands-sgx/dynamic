enclave {
    trusted {
        public sgx_status_t examC_set_regime(uint32_t regime_id);
        public sgx_status_t examC_seal_voucher(
            uint32_t voucher_tier,
            [out, size=v_len] uint8_t *v_out,
            size_t v_len
        );
        public sgx_status_t examC_redeem_voucher(
            uint32_t redeem_op,
            [in, size=v_len] const uint8_t *v_in,
            size_t v_len,
            [out, size=out_len] uint8_t *out_buf,
            size_t out_len
        );
        public sgx_status_t examC_init_engine(uint32_t eng_seed);
        public sgx_status_t examC_dispatch_batch(
            uint32_t batch_op,
            [in, size=pay_len] const uint8_t *pay_buf,
            size_t pay_len,
            [in, size=aux_len] const uint8_t *aux_buf,
            size_t aux_len,
            [out, size=out_len] uint8_t *out_buf,
            size_t out_len
        );
        public sgx_status_t examC_advance_phase(uint32_t phase_step);
    };
};
