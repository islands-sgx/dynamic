enclave {
    trusted {
        public sgx_status_t ecall_init(uint32_t seed);
        public sgx_status_t ecall_configure_stage(uint32_t stage_mode);
        public sgx_status_t ecall_advance_step(uint32_t delta);
        public sgx_status_t ecall_Execute(
            uint32_t op_mode,
            [in, size=in_len] const uint8_t *in_buf,
            size_t in_len,
            [in, size=aux_len] const uint8_t *aux_buf,
            size_t aux_len,
            [out, size=out_len] uint8_t *out_buf,
            size_t out_len
        );
        public sgx_status_t ecall_mint_token(
            uint32_t token_profile,
            [out, size=token_len] uint8_t *token_out,
            size_t token_len
        );
        public sgx_status_t ecall_consume_vault(
            uint32_t vault_op,
            [in, size=token_len] const uint8_t *token_in,
            size_t token_len,
            [out, size=out_len] uint8_t *out_buf,
            size_t out_len
        );
    };
};
