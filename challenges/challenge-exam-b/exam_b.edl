enclave {
    trusted {
        public sgx_status_t examB_tick_clock(uint32_t tick_step);
        public sgx_status_t examB_issue_ticket(
            uint32_t ticket_kind,
            [out, size=tkt_len] uint8_t *tkt_out,
            size_t tkt_len
        );
        public sgx_status_t examB_configure_gate(uint32_t gate_code);
        public sgx_status_t examB_verify_ticket(
            uint32_t verify_cmd,
            [in, size=tkt_len] const uint8_t *tkt_in,
            size_t tkt_len,
            [out, size=out_len] uint8_t *out_buf,
            size_t out_len
        );
        public sgx_status_t examB_reset_context(uint32_t ctx_seed);
        public sgx_status_t examB_transform_packet(
            uint32_t pkt_mode,
            [in, size=pkt_len] const uint8_t *pkt_buf,
            size_t pkt_len,
            [in, size=tag_len] const uint8_t *tag_buf,
            size_t tag_len,
            [out, size=out_len] uint8_t *out_buf,
            size_t out_len
        );
    };
};
