enclave {
    trusted {
        public sgx_status_t examA_mint_credential(
            uint32_t cred_level,
            [out, size=cred_len] uint8_t *cred_out,
            size_t cred_len
        );
        public sgx_status_t examA_audit_vault(
            uint32_t audit_cmd,
            [in, size=cred_len] const uint8_t *cred_in,
            size_t cred_len,
            [out, size=out_len] uint8_t *out_buf,
            size_t out_len
        );
        public sgx_status_t examA_set_policy(uint32_t policy_code);
        public sgx_status_t examA_step_epoch(uint32_t step_inc);
        public sgx_status_t examA_process_frame(
            uint32_t frame_mode,
            [in, size=frame_len] const uint8_t *frame_buf,
            size_t frame_len,
            [in, size=hdr_len] const uint8_t *hdr_buf,
            size_t hdr_len,
            [out, size=out_len] uint8_t *out_buf,
            size_t out_len
        );
        public sgx_status_t examA_boot_session(uint32_t boot_seed);
    };
};
